# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Configuration (alternative to OpenAI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Semantic Scholar API key (helps with shared unauthenticated rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Database Configuration (for LangGraph checkpointing)
DATABASE_PASSWORD=your_database_password_here

# Optional: Logging
LOG_LEVEL=INFO
